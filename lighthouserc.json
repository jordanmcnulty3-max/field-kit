{
  "ci": {
    "collect": {
      "staticDistDir": "./_site",
      "url": [
        "http://localhost/index.html#/survival",
        "http://localhost/index.html#/tactical/map",
        "http://localhost/index.html#/emergency"
      ],
      "numberOfRuns": 1,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 360, "height": 640, "deviceScaleFactor": 3, "disabled": false }
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.4 }],
        "viewport-insight": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "color-contrast": "error",
        "button-name": "error",
        "label": "error",
        "target-size": "warn",
        "label-content-name-mismatch": "warn"
      }
    },
    "upload": { "target": "filesystem", "outputDir": "./lhci-report" }
  }
}
